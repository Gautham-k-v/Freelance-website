# EmailJS public configuration.
# 1. Connect Gmail in EmailJS so mail can be sent as codextech2025@gmail.com.
# 2. Admin template (VITE_EMAILJS_CONTACT_TEMPLATE_ID):
#    To email: codextech2025@gmail.com
#    Reply To: {{from_email}}
# 3. Customer auto-reply template (VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID):
#    To email: {{email}}
# 4. Both templates can use:
#    {{from_name}} {{name}} {{from_email}} {{email}} {{phone}} {{company}}
#    {{service}} {{budget}} {{message}} {{to_email}} {{reply_to}}
#
# Never add your EmailJS private key. Only the public key belongs here.
# Copy this file to .env, fill in the values, and restart the dev server.
# On Vercel, add the same names under Project Settings → Environment Variables,
# then redeploy. Vite reads them only while it builds.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
